        <mxCell id="s-partial-ods" value="Partially Delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1140" y="970" width="150" height="45" as="geometry" />
        </mxCell>

        <mxCell id="gi-none" value="NONE of Deliveries&#xa;Goods Issued?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
