        <mxCell id="s-open-gi" value="Open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="1105" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gi-partial" value="At least one Delivery&#xa;is Goods Issued&#xa;(and not all)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="1220" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s-partial-gi" value="Partially Delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="1250" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Rule 5: overallDeliveryStatus = A -->
        <mxCell id="r5" value="overallDeliveryStatus = 'A'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
